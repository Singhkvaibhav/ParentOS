# Production configuration template.
#
# Copy to .env.production and fill in. Every value marked REQUIRED is
# checked at startup by backend/configCheck.js - the process refuses to
# boot without them rather than starting insecurely, so a missing secret
# fails loudly at deploy time instead of quietly at 3am.
#
# This file is a TEMPLATE. Real secrets should come from a secret manager
# (AWS Secrets Manager, Doppler, Vault, or your platform's own store) and
# be injected as environment variables. Committing a filled-in .env.production
# is the single most common way credentials leak - .gitignore covers it,
# but the safer habit is never creating the file on a developer machine at all.

NODE_ENV=production

# --- REQUIRED: core ---------------------------------------------------------
# At least 32 characters, from a CSPRNG. Rotating it logs everyone out,
# which is the intended behaviour if it is ever exposed.
#   openssl rand -base64 48
JWT_SECRET=

# Set by docker-compose from POSTGRES_PASSWORD; set manually otherwise.
DATABASE_URL=

# Comma-separated, https only, no wildcards. Wildcards plus credentialed
# cookies is a CSRF hole no token check fully closes.
CORS_ORIGINS=https://parentos.example

# --- REQUIRED: payments -----------------------------------------------------
# A test key here means no real money moves; startup warns rather than
# fails, since staging legitimately uses test keys.
STRIPE_SECRET_KEY=
# Without this, webhook signatures cannot be verified - either payments
# never settle, or forged webhooks are accepted.
STRIPE_WEBHOOK_SECRET=

# --- REQUIRED: email --------------------------------------------------------
# Verification codes are how accounts get created. Without SMTP, codes only
# reach the logs and nobody can sign up.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ParentOS <no-reply@parentos.example>"

# --- Strongly recommended ---------------------------------------------------
# Without object storage, uploaded images live on a container volume and do
# not survive moving hosts. Startup warns if unset.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for Cloudflare R2 / Backblaze B2 / MinIO; omit for real AWS S3.
S3_ENDPOINT=
S3_PUBLIC_URL_BASE=

# Set by docker-compose. Without it, background jobs run in-process and are
# lost on restart, and rate limits become per-instance.
REDIS_URL=

# --- Optional ---------------------------------------------------------------
ERROR_TRACKING_DSN=
RELEASE_SHA=
ANTHROPIC_API_KEY=

# Geocoding provider: table (default, no network), nominatim, or google.
# Changing this takes on a third party's latency, rate limits and outages,
# so it is deliberately an explicit choice.
GEOCODER=table
GOOGLE_MAPS_API_KEY=

LOG_LEVEL=info
BACKUP_RETENTION_DAYS=14
