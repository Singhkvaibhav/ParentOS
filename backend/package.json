{
  "name": "parentos-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node migrate.js",
    "test": "jest --runInBand",
    "lint": "eslint .",
    "worker": "node worker.js",
    "reconcile": "node scripts/reconcile.js",
    "verify": "bash ../verify.sh",
    "journey": "node scripts/journey.js",
    "smoke:stripe": "node scripts/smoke-stripe.js",
    "e2e": "node scripts/e2e.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "sharp": "^0.33.5",
    "stripe": "^16.9.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/teardown.js"
    ],
    "testTimeout": 15000
  }
}