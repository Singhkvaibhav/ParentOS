PORT=4000
NODE_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=20000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parentos

# Object storage (optional). Leave unset to store uploaded images on local
# disk under backend/uploads/ (served at /uploads) - fine for local dev.
# Set these to use real S3-compatible storage (AWS S3, Cloudflare R2,
# Backblaze B2, MinIO, etc.) instead:
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL_BASE=

# Stripe (test mode) - see database/README notes for setup.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
COMMISSION_PERCENT=8
RESERVATION_TTL_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Email (optional). Leave unset to log verification emails to the console
# instead of sending them - fine for local dev. Set these to send real
# emails via any SMTP provider (Postmark, SES, SendGrid, Gmail, etc.):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Uusiksi <no-reply@yourdomain.example>"
