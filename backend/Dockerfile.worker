# The background worker: same code and dependencies as the API, different
# entry point.
#
# A separate image would drift; a separate CONTAINER from the same image is
# what's wanted, so workers can be scaled and restarted independently of
# web traffic without maintaining two builds.
FROM node:20-slim AS deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev

FROM node:20-slim AS runtime
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN chown -R node:node /app
USER node
ENV NODE_ENV=production

# No healthcheck and no EXPOSE: the worker serves no traffic. Its health is
# observable through job success/failure in the logs and queue depth in
# Redis, not through an HTTP probe.
CMD ["node", "worker.js"]
