VITE_API_URL=/api

# Product analytics (funnels, session replay - see src/productAnalytics.js).
# Leave unset to disable entirely, including the cookie-consent banner -
# there's nothing to ask consent for if nothing can be tracked. Get a key
# free at posthog.com; VITE_POSTHOG_HOST only needs setting for a
# self-hosted PostHog instance.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
